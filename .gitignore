# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# screenshoot-app specific
/exports/
/scripts/test-*.ts
/aso-project
/private
/specs

# user projects stay local — only the reference example-app is versioned
/projects/*
!/projects/example-app/
/projects/example-app/assets/*
!/projects/example-app/assets/.gitkeep
!/projects/example-app/assets/home.png
!/projects/lshoot/
/projects/lshoot/assets/*
!/projects/lshoot/assets/.gitkeep

# Claude Code local state — only the shipped skills are versioned
/.claude/*
!/.claude/skills/
