# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# screenshoot-app specific
/exports/
/scripts/test-*.ts
/aso-project
/private
/specs

# projects/ must NOT be gitignored: Tailwind v4 skips gitignored files during
# source detection, so ignoring it silently drops every utility class used only
# by a screenshot (headlines render at 16px). Personal projects simply stay
# untracked — never `git add -A` in this repo, stage explicit paths.
# Only the raw app captures are ignored.
/projects/*/assets/*
!/projects/*/assets/.gitkeep
!/projects/example-app/assets/home.png

# Claude Code local state — only the shipped skills are versioned
/.claude/*
!/.claude/skills/
